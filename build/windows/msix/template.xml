<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="JPTAnnounce"
        Arguments=""
        InstallLocation="C:\Program Files\JPT\JPT Announce">
    </Installer>
    <PackageInformation
        PackageName="JPT Announce"
        PackageDisplayName="JPT Announce"
        PublisherName="CN=JPT"
        PublisherDisplayName="JPT"
        Version="0.1.0.0"
        PackageDescription="Aplikasi Penjadwalan dan Pemutaran Pengumuman Audio">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="id.jpt.announce"
                Description="Aplikasi Penjadwalan dan Pemutaran Pengumuman Audio"
                DisplayName="JPT Announce"
                ExecutableName="JPTAnnounce"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>JPT Announce</DisplayName>
            <PublisherDisplayName>JPT</PublisherDisplayName>
            <Description>Aplikasi Penjadwalan dan Pemutaran Pengumuman Audio</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="jpt-announce.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
